{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ball_kinematics.schema.json",
  "title": "Ball Kinematics v1",
  "type": "object",
  "required": ["status", "method", "samples_used", "rejected_samples", "confidence", "warnings"],
  "properties": {
    "status": {"enum": ["available", "unavailable"]},
    "method": {"enum": ["pixel_apparent", "court_planar_xy", "estimated_3d"]},
    "incoming_speed_mps": {"type": ["number", "null"]},
    "incoming_speed_kmh": {"type": ["number", "null"]},
    "outgoing_speed_mps": {"type": ["number", "null"]},
    "outgoing_speed_kmh": {"type": ["number", "null"]},
    "peak_outgoing_speed_kmh": {"type": ["number", "null"]},
    "speed_at_net_kmh": {"type": ["number", "null"]},
    "speed_before_bounce_kmh": {"type": ["number", "null"]},
    "speed_after_bounce_kmh": {"type": ["number", "null"]},
    "samples_used": {"type": "integer", "minimum": 0},
    "rejected_samples": {"type": "integer", "minimum": 0},
    "window_start_seconds": {"type": ["number", "null"]},
    "window_end_seconds": {"type": ["number", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
