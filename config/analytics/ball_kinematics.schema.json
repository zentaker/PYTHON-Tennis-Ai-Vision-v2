{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tennis-vision.local/schemas/ball_kinematics.schema.json",
  "title": "Ball Kinematics v1",
  "type": "object",
  "required": [
    "status", "method", "speed_unit", "incoming_status", "outgoing_status",
    "incoming_speed_mps", "incoming_speed_kmh", "outgoing_speed_mps", "outgoing_speed_kmh",
    "peak_outgoing_speed_kmh", "speed_at_net_kmh", "speed_before_bounce_kmh",
    "speed_after_bounce_kmh", "samples_used", "rejected_samples", "incoming_samples_used",
    "incoming_rejected_samples", "outgoing_samples_used", "outgoing_rejected_samples",
    "window_start_seconds", "window_end_seconds", "confidence", "incoming_confidence",
    "outgoing_confidence", "warnings"
  ],
  "properties": {
    "status": {"enum": ["available", "partial", "unavailable"]},
    "method": {"enum": ["pixel_apparent", "court_planar_xy", "estimated_3d"]},
    "speed_unit": {"enum": ["pixels_per_second", "metres_per_second"]},
    "incoming_status": {"enum": ["available", "unavailable"]},
    "outgoing_status": {"enum": ["available", "unavailable"]},
    "incoming_speed_mps": {"type": ["number", "null"], "minimum": 0},
    "incoming_speed_kmh": {"type": ["number", "null"], "minimum": 0},
    "outgoing_speed_mps": {"type": ["number", "null"], "minimum": 0},
    "outgoing_speed_kmh": {"type": ["number", "null"], "minimum": 0},
    "peak_outgoing_speed_kmh": {"type": ["number", "null"], "minimum": 0},
    "speed_at_net_kmh": {"type": ["number", "null"], "minimum": 0},
    "speed_before_bounce_kmh": {"type": ["number", "null"], "minimum": 0},
    "speed_after_bounce_kmh": {"type": ["number", "null"], "minimum": 0},
    "samples_used": {"type": "integer", "minimum": 0},
    "rejected_samples": {"type": "integer", "minimum": 0},
    "incoming_samples_used": {"type": "integer", "minimum": 0},
    "incoming_rejected_samples": {"type": "integer", "minimum": 0},
    "outgoing_samples_used": {"type": "integer", "minimum": 0},
    "outgoing_rejected_samples": {"type": "integer", "minimum": 0},
    "window_start_seconds": {"type": ["number", "null"]},
    "window_end_seconds": {"type": ["number", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "incoming_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "outgoing_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
