{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stroke_analytics.schema.json",
  "title": "Stroke Analytics v1",
  "type": "object",
  "required": ["schema_version", "event", "stroke", "kinematics", "evidence"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event": {
      "type": "object",
      "required": ["event_id", "timestamp_seconds"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "timestamp_seconds": {"type": "number"}
      },
      "additionalProperties": true
    },
    "stroke": {
      "type": "object",
      "required": ["stroke_side", "contact_mode", "spin_family", "tactical_shape", "hitting_hand"],
      "properties": {
        "stroke_side": {"$ref": "#/$defs/strokeSide"},
        "contact_mode": {"$ref": "#/$defs/contactMode"},
        "spin_family": {"$ref": "#/$defs/spinFamily"},
        "tactical_shape": {"$ref": "#/$defs/tacticalShape"},
        "hitting_hand": {"$ref": "#/$defs/hittingHand"}
      },
      "additionalProperties": false
    },
    "kinematics": {"type": ["object", "null"]},
    "evidence": {"type": "array"}
  },
  "$defs": {
    "confidence": {
      "type": "object",
      "required": ["source", "method", "confidence", "warnings", "dependencies", "human_labeled", "model_inferred", "geometry_derived"],
      "properties": {
        "source": {"type": "string"},
        "method": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "human_labeled": {"type": "boolean"},
        "model_inferred": {"type": "boolean"},
        "geometry_derived": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "strokeSide": {"$ref": "#/$defs/dimensionBase", "properties": {"value": {"enum": ["serve", "forehand", "backhand", "overhead", "unknown"]}}},
    "contactMode": {"$ref": "#/$defs/dimensionBase", "properties": {"value": {"enum": ["serve", "return", "groundstroke", "volley", "half_volley", "overhead", "unknown"]}}},
    "spinFamily": {"$ref": "#/$defs/dimensionBase", "properties": {"value": {"enum": ["flat", "topspin", "slice", "unknown"]}}},
    "tacticalShape": {"$ref": "#/$defs/dimensionBase", "properties": {"value": {"enum": ["drive", "drop", "lob", "approach", "passing_shot", "defensive", "neutral", "unknown"]}}},
    "hittingHand": {"$ref": "#/$defs/dimensionBase", "properties": {"value": {"enum": ["left", "right", "unknown"]}}},
    "dimensionBase": {
      "type": "object",
      "required": ["value", "confidence"],
      "properties": {"value": {"type": "string"}, "confidence": {"$ref": "#/$defs/confidence"}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
