{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tennisai.local/schemas/ball-track-point-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rally_id", "frame_id", "timestamp_seconds", "pixel_x", "pixel_y", "confidence", "source", "visible", "warnings"],
  "properties": {
    "schema_version": {"const": "ball_track_point.v1"},
    "rally_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "frame_id": {"type": "integer", "minimum": 0},
    "timestamp_seconds": {"type": "number", "minimum": 0},
    "pixel_x": {"type": ["number", "null"]},
    "pixel_y": {"type": ["number", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "source": {"enum": ["raw", "smoothed", "interpolated"]},
    "visible": {"type": "boolean"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
