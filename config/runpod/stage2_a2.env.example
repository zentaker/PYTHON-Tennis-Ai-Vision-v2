# Copiar fuera del repositorio o como un archivo .env ignorado antes de completar.
# No guardar aquí IPs, usuarios reales, tokens ni rutas de claves privadas.

# Valores permitidos: proxy o exposed_tcp.
RUNPOD_SSH_MODE="proxy"
RUNPOD_TRANSFER_MODE="runpodctl"
RUNPOD_SSH_KEY="$HOME/.ssh/id_ed25519"

# Proxy básico: terminal SSH + runpodctl, sin SCP/SFTP/rsync.
RUNPOD_SSH_TARGET="USUARIO_TEMPORAL@ssh.runpod.io"

# exposed_tcp: completar estos campos y usar RUNPOD_TRANSFER_MODE="scp".
RUNPOD_HOST="HOST_PUBLICO_DEL_POD"
RUNPOD_SSH_USER="root"
RUNPOD_SSH_PORT="PUERTO_SSH_PUBLICO"

RUNPOD_REPO_URL="https://github.com/zentaker/PYTHON-Tennis-Ai-Vision-v2.git"
RUNPOD_REPO_DIR="/workspace/PYTHON-Tennis-Ai-Vision-v2"
RUNPOD_COMMIT_SHA="SHA_COMPLETO_DE_40_CARACTERES"
RUNPOD_CONFIDENCE_THRESHOLD="0.5"
RUNPOD_PYTHON_VERSION="3.11"

# Solo para recibir un bundle mediante runpodctl; no persistir códigos temporales.
# RUNPOD_TRANSFER_CODE=""
# RUNPOD_BUNDLE_SHA256=""
