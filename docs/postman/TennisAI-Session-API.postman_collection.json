    {
      "item": [
        {
          "_openapiMethod": "POST",
          "_openapiPath": "/api/v1/sessions/{session_id}/uploads",
          "_operationId": "initiateVideoUpload",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const payload = pm.response.json();\npm.environment.set('videoId', payload.video_id);\npm.collectionVariables.set('uploadUrl', payload.upload_url);\npm.collectionVariables.set('uploadContentType', payload.required_headers['Content-Type']);\nconst requested = pm.request.body.raw ? JSON.parse(pm.request.body.raw) : {};\npm.collectionVariables.set('uploadSizeBytes', String(requested.size_bytes || ''));\npm.collectionVariables.set('uploadSha256', requested.sha256 || '');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "name": "Initiate a video upload",
          "protocolProfileBehavior": {},
          "request": {
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"content_type\": \"video/mp4\",\n  \"display_name\": \"rally.mp4\",\n  \"size_bytes\": 1048576\n}"
            },
            "description": "Validate source-video metadata and return a short-lived presigned PUT URL.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "sessions",
                "{{sessionId}}",
                "uploads"
              ],
              "raw": "{{baseUrl}}/api/v1/sessions/{{sessionId}}/uploads"
            }
          },
          "response": []
        },
        {
          "_generatedWorkflow": "presignedUpload",
          "name": "Upload bytes to presigned URL",
          "protocolProfileBehavior": {},
          "request": {
            "body": {
              "file": {
                "src": ""
              },
              "mode": "file"
            },
            "description": "Generated workflow step. Select the local source file in Postman; the collection intentionally contains no video bytes.",
            "header": [
              {
                "key": "Content-Type",
                "value": "{{uploadContentType}}"
              }
            ],
            "method": "PUT",
            "url": {
              "raw": "{{uploadUrl}}"
            }
          },
          "response": []
        },
        {
          "_openapiMethod": "POST",
          "_openapiPath": "/api/v1/sessions/{session_id}/uploads/{video_id}/complete",
          "_operationId": "completeVideoUpload",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const body = {\n  size_bytes: Number(pm.collectionVariables.get('uploadSizeBytes')),\n  content_type: pm.collectionVariables.get('uploadContentType')\n};\nconst sha256 = pm.collectionVariables.get('uploadSha256');\nif (sha256) body.sha256 = sha256;\npm.request.body.update(JSON.stringify(body, null, 2));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {\n  pm.collectionVariables.unset('uploadUrl');\n  pm.collectionVariables.unset('uploadContentType');\n  pm.collectionVariables.unset('uploadSizeBytes');\n  pm.collectionVariables.unset('uploadSha256');\n}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "name": "Complete a video upload",
          "protocolProfileBehavior": {},
          "request": {
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"content_type\": \"video/mp4\",\n  \"size_bytes\": 1048576\n}"
            },
            "description": "HEAD the object in MinIO/S3 and mark it STORAGE_VERIFIED when metadata matches.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "sessions",
                "{{sessionId}}",
                "uploads",
                "{{videoId}}",
                "complete"
              ],
              "raw": "{{baseUrl}}/api/v1/sessions/{{sessionId}}/uploads/{{videoId}}/complete"
            }
          },
          "response": []
        }
